# Backend: copy to root .env, or run python -m backend.scripts.init_local
# Credentials must be supplied locally. Never commit .env.
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
# false uses real providers; true uses explicitly labelled offline replay.
DEMO_MODE=false
FRONTEND_URL=http://127.0.0.1:3000
HTTP_TIMEOUT=8
REQUEST_TIMEOUT=35
HTTP_RETRIES=2
CACHE_MAX_ENTRIES=512
WEATHER_TTL=600
OCEAN_TTL=1800
SATELLITE_TTL=21600
PFZ_TTL=21600
OPEN_METEO_ENABLED=true
INCOIS_ERDDAP_ENABLED=true
# Optional reviewed normalized local GeoJSON paths, never remote URLs.
PFZ_IMPORT_FILE=
ZONES_IMPORT_FILE=

# Part 2: LLM Provider Configuration (gemini, openai, groq, or mock)
LLM_PROVIDER=mock
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=

# Part 2: Bhashini Voice Configuration (ULCA / Dhruva inference)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_PIPELINE_ID=
